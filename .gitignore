# Python bytecode and build output
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Test and tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Local firmware images, flash backups and downloads.
# The vendor firmware is not redistributable; keep it out of the repository.
*.bin
*.bin.part
*.flash-*.bin
*.exe
*.part

# Local configuration and secrets
.env
.env.*
*.local

# Editors and operating systems
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

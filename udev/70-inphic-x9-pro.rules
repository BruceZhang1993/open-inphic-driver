# Give the active local session access to the receiver's configuration interface.
SUBSYSTEM=="hidraw", KERNELS=="0003:32C2:0027.*", IMPORT{builtin}="usb_id", ENV{ID_USB_INTERFACE_NUM}=="02", TAG+="uaccess"

# Wired mouse configuration interface (used by the firmware upgrade).
SUBSYSTEM=="hidraw", KERNELS=="0003:32C2:0024.*", IMPORT{builtin}="usb_id", ENV{ID_USB_INTERFACE_NUM}=="02", TAG+="uaccess"

# BootV1 bootloader interface.  It is a separate USB device with a single
# vendor collection when the mouse reboots for a firmware upgrade.
SUBSYSTEM=="hidraw", KERNELS=="0003:32C2:001B.*", IMPORT{builtin}="usb_id", TAG+="uaccess"
